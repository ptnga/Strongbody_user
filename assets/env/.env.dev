# Chỉ đặt config public ở đây — file này được bundle vào app, KHÔNG để secret.
APP_NAME="StrongBody Buyer Dev"
API_BASE_URL=https://api-v2.strongbody.ai/v1
WEB_BASE_URL=https://strongbody.ai
PUBLIC_API_KEY=your_api_key
# Đăng nhập Google/Apple — điền khi đã tạo client ID cho bundle ai.strongbody.strongbody_buyer
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
APPLE_SIGN_IN_ENABLED=false
# chat-server (WS + REST history/publish) — như Multime
CHAT_SERVER_URL=wss://chat.strongbody.ai
CHAT_SERVER_TENANT=strongbody
# Lion Points (point service) — như web `API_POINT_URL`
POINT_API_URL=https://point-api.strongbody.ai/api
# Stripe publishable key (public) — cùng key Multime dùng với api-v2 (LIVE: thanh toán thật)
STRIPE_PUBLISHABLE_KEY=pk_live_51PEuUKG85tvz3DWLD9As4atdrIbuFPxlM32NmnIx6aksnMptgRlsGuXYeh8Z5rUtUQjEbUgvOEDOkZ2YzmcpYeDX00t6A4vRl0
